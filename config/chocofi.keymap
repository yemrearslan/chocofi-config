/* 
 * Chocofi ZMK Config - Türkçe QWERTY OS Çevirmenli
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/* 
 * ---------------------------------------------------------
 * TÜRKÇE KARAKTER TANIMLARI (TRANSLATOR)
 * İşletim sistemi dili "Turkish QWERTY" olduğu varsayılmıştır.
 * Biz İngilizce harf gönderdiğimizde OS bunu Türkçe yorumlar.
 * ---------------------------------------------------------
 */
#define TR_I    SQT     // ZMK ' gönderir -> TR OS 'i' yazar
#define TR_DOT  FSLH    // ZMK / gönderir -> TR OS '.' yazar
#define TR_COMM KP_COMMA // Bazen sadece , çalışır bazen keypad comma.
// Aşağıdakiler Türkçe Layer için:
#define TR_S    SEMI    // ; -> ş
#define TR_C    DOT     // . -> ç
#define TR_O    COMMA   // , -> ö
#define TR_U    RBKT    // ] -> ü
#define TR_G    LBKT    // [ -> ğ
#define TR_II   I       // I -> ı

/* KATMAN İSİMLERİ (Kolay okunsun diye) */
#define MAC     0
#define LIN     1
#define NAV     2
#define SYM     3
#define TR      4
#define ADJ     5  // Ayar katmanı

/ {
    /* 
     * BEHAVIORS (DAVRANIŞLAR)
     * Burası klavyenin "akıllı" özelliklerini tanımladığımız yer.
     */
    behaviors {
        // Home Row Mods: Hızlı yazarken yanlışlıkla Shift/Ctrl açılmasın diye ayar
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;    // 200ms basılı tutarsan Mod olur
            quick-tap-ms = <150>;       // Hızlı ardışık basışlarda takılmasın
            flavor = "tap-preferred";   // Harf basmayı önceliklendir
            bindings = <&kp>, <&kp>;
        };
    };

    /*
     * MACROLAR
     * Tek tuşla birden fazla iş yapma
     */
    macros {
        // Mac için Fullscreen (Cmd+Ctrl+F)
        mac_full: mac_fullscreen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LGUI &kp LCTRL &kp F>;
        };
        // Linux/Gnome için Fullscreen (Genelde F11 veya Super+F)
        // Senin Linux ayarlarına göre burayı değiştirebilirsin
        lin_full: linux_fullscreen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F11>; 
        };
    };

    /*
     * KEYMAP (TUŞ HARİTASI)
     * Matrisin görsel hali. 
     * 36 Tuş: Sol 5x3 + 3 Başparmak | Sağ 5x3 + 3 Başparmak
     */
    keymap {
        compatible = "zmk,keymap";

        // -----------------------------------------------------------------------------------------
        // LAYER 0: MAC BASE (Varsayılan)
        // Home Row Mods: A(Cmd), S(Opt), D(Ctrl), F(Shift)
        // -----------------------------------------------------------------------------------------
        mac_layer {
            bindings = <
    &kp Q       &kp W       &kp E       &kp R       &kp T          &kp Y       &kp U       &kp TR_I    &kp O       &kp P
    &hm LGUI A  &hm LALT S  &hm LCTRL D &hm LSHFT F &kp G          &kp H       &hm RSHFT J &hm RCTRL K &hm RALT L  &hm RGUI SQT
    &kp Z       &kp X       &kp C       &kp V       &kp B          &kp N       &kp M       &kp COMMA   &kp TR_DOT  &kp QMARK
               /* SOL BAŞPARMAKLAR */                              /* SAĞ BAŞPARMAKLAR */
               &lt ADJ ESC  &kp TAB     &lt NAV SPACE              &lt SYM ENTER  &lt TR BSPC  &lt ADJ DEL
            >;
        };

        // -----------------------------------------------------------------------------------------
        // LAYER 1: LINUX/ANDROID BASE
        // Home Row Mods: A(Ctrl), S(Alt), D(Gui/Win), F(Shift) -> Linux'ta genelde Ctrl en dıştadır.
        // İsteğine göre buradaki &hm sıralamasını değiştirebiliriz.
        // -----------------------------------------------------------------------------------------
        linux_layer {
            bindings = <
    &kp Q       &kp W       &kp E       &kp R       &kp T          &kp Y       &kp U       &kp TR_I    &kp O       &kp P
    &hm LCTRL A &hm LALT S  &hm LGUI D  &hm LSHFT F &kp G          &kp H       &hm RSHFT J &hm RGUI K  &hm RALT L  &hm RCTRL SQT
    &kp Z       &kp X       &kp C       &kp V       &kp B          &kp N       &kp M       &kp COMMA   &kp TR_DOT  &kp QMARK
                            &lt ADJ ESC &kp TAB     &lt NAV SPACE  &lt SYM ENTER  &lt TR BSPC  &lt ADJ DEL
            >;
        };

        // -----------------------------------------------------------------------------------------
        // LAYER 2: NAVIGATION (Sol Başparmak - SPACE basılıyken)
        // -----------------------------------------------------------------------------------------
        nav_layer {
            bindings = <
    &kp N1      &kp N2      &kp N3      &kp N4      &kp N5         &kp PG_UP   &kp HOME    &kp UP      &kp END     &kp INS
    &kp LGUI    &kp LALT    &kp LCTRL   &kp LSHFT   &mac_full      &kp PG_DN   &kp LEFT    &kp DOWN    &kp RIGHT   &kp CAPS
    &kp N6      &kp N7      &kp N8      &kp N9      &kp N0         &kp LC(X)   &kp LC(C)   &kp LC(V)   &kp C_MUTE  &kp C_VOL_UP
                            &trans      &trans      &trans         &trans      &trans      &trans
            >;
            // Not: &mac_full makrosu buraya kondu. Linux layerındayken buraya &lin_full koymak için
            // ayrı bir nav layer yapmak gerekir ama şimdilik basitten gidelim.
        };

        // -----------------------------------------------------------------------------------------
        // LAYER 3: SYMBOLS (Sağ İç Başparmak - ENTER basılıyken)
        // Parantezlerin sağ elde olması kodlama hızını artırır.
        // -----------------------------------------------------------------------------------------
        sym_layer {
            bindings = <
    &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT      &kp CARET   &kp LPAR    &kp RPAR    &kp UNDER   &kp PIPE
    &kp GRAVE   &kp TILDE   &kp QMARK   &kp DQT     &kp SQT        &kp AMPS    &kp LBRC    &kp RBRC    &kp EQUAL   &kp PLUS
    &kp BSLH    &trans      &trans      &trans      &trans         &kp STAR    &kp LBKT    &kp RBKT    &kp MINUS   &kp FSLH
                            &trans      &trans      &trans         &trans      &trans      &trans
            >;
        };

        // -----------------------------------------------------------------------------------------
        // LAYER 4: TURKISH CHARS (Sağ Orta Başparmak - BSPC basılıyken)
        // Bastığın tuşun Türkçe karşılığını gönderir.
        // -----------------------------------------------------------------------------------------
        tr_layer {
            bindings = <
    &trans      &trans      &trans      &trans      &trans         &trans      &kp TR_U    &kp TR_II   &kp TR_O    &trans
    &trans      &kp TR_S    &trans      &trans      &kp TR_G       &trans      &trans      &trans      &trans      &trans
    &trans      &trans      &kp TR_C    &trans      &trans         &trans      &trans      &trans      &trans      &trans
                            &trans      &trans      &trans         &trans      &trans      &trans
            >;
        };

        // -----------------------------------------------------------------------------------------
        // LAYER 5: ADJUST & CONFIG (En Dış Başparmaklar ile)
        // OS değiştirmek için burayı kullanacağız.
        // -----------------------------------------------------------------------------------------
        adj_layer {
            bindings = <
    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR     &trans      &trans      &trans      &trans      &trans
    &to MAC      &to LIN      &trans       &trans       &trans         &trans      &trans      &trans      &trans      &trans
    &trans       &trans       &trans       &trans       &trans         &trans      &trans      &trans      &trans      &trans
                              &trans       &trans       &trans         &trans      &trans      &trans
            >;
        };
    };
};
