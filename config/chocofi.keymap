/* 
 * CORNE KILIGINA GIRMIS CHOCOFI CONFIG
 * Dosya adı: corne.keymap (olmak zorunda)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/* TÜRKÇE KARAKTER TANIMLARI */
#define TR_I    SQT
#define TR_DOT  FSLH
#define TR_COMM KP_COMMA
#define TR_S    SEMI
#define TR_C    DOT
#define TR_O    COMMA
#define TR_U    RBKT
#define TR_G    LBKT
#define TR_II   I

#define MAC     0
#define LIN     1
#define NAV     2
#define SYM     3
#define TR      4
#define ADJ     5

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        mac_full: mac_fullscreen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LGUI &kp LCTRL &kp F>;
        };
        lin_full: linux_fullscreen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F11>; 
        };
    };

    /* 
     * DİKKAT: Corne Shield kullandığımız için 42 tuş tanımlamalıyız.
     * Chocofi 36 tuş olduğu için her satırın başına ve sonuna &none ekledik.
     */
    keymap {
        compatible = "zmk,keymap";

        mac_layer {
            bindings = <
    &none  &kp Q       &kp W       &kp E       &kp R       &kp T          &kp Y       &kp U       &kp TR_I    &kp O       &kp P          &none
    &none  &hm LGUI A  &hm LALT S  &hm LCTRL D &hm LSHFT F &kp G          &kp H       &hm RSHFT J &hm RCTRL K &hm RALT L  &hm RGUI SQT   &none
    &none  &kp Z       &kp X       &kp C       &kp V       &kp B          &kp N       &kp M       &kp COMMA   &kp TR_DOT  &kp QMARK      &none
                                   &lt ADJ ESC &kp TAB     &lt NAV SPACE  &lt SYM ENTER &lt TR BSPC &lt ADJ DEL
            >;
        };

        linux_layer {
            bindings = <
    &none  &kp Q       &kp W       &kp E       &kp R       &kp T          &kp Y       &kp U       &kp TR_I    &kp O       &kp P          &none
    &none  &hm LCTRL A &hm LALT S  &hm LGUI D  &hm LSHFT F &kp G          &kp H       &hm RSHFT J &hm RGUI K  &hm RALT L  &hm RCTRL SQT  &none
    &none  &kp Z       &kp X       &kp C       &kp V       &kp B          &kp N       &kp M       &kp COMMA   &kp TR_DOT  &kp QMARK      &none
                                   &lt ADJ ESC &kp TAB     &lt NAV SPACE  &lt SYM ENTER &lt TR BSPC &lt ADJ DEL
            >;
        };

        nav_layer {
            bindings = <
    &none  &kp N1      &kp N2      &kp N3      &kp N4      &kp N5         &kp PG_UP   &kp HOME    &kp UP      &kp END     &kp INS        &none
    &none  &kp LGUI    &kp LALT    &kp LCTRL   &kp LSHFT   &mac_full      &kp PG_DN   &kp LEFT    &kp DOWN    &kp RIGHT   &kp CAPS       &none
    &none  &kp N6      &kp N7      &kp N8      &kp N9      &kp N0         &kp LC(X)   &kp LC(C)   &kp LC(V)   &kp C_MUTE  &kp C_VOL_UP   &none
                                   &trans      &trans      &trans         &trans      &trans      &trans
            >;
        };

        sym_layer {
            bindings = <
    &none  &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT      &kp CARET   &kp LPAR    &kp RPAR    &kp UNDER   &kp PIPE       &none
    &none  &kp GRAVE   &kp TILDE   &kp QMARK   &kp DQT     &kp SQT        &kp AMPS    &kp LBRC    &kp RBRC    &kp EQUAL   &kp PLUS       &none
    &none  &kp BSLH    &trans      &trans      &trans      &trans         &kp STAR    &kp LBKT    &kp RBKT    &kp MINUS   &kp FSLH       &none
                                   &trans      &trans      &trans         &trans      &trans      &trans
            >;
        };

        tr_layer {
            bindings = <
    &none  &trans      &trans      &trans      &trans      &trans         &trans      &kp TR_U    &kp TR_II   &kp TR_O    &trans         &none
    &none  &trans      &kp TR_S    &trans      &trans      &kp TR_G       &trans      &trans      &trans      &trans      &trans         &none
    &none  &trans      &trans      &kp TR_C    &trans      &trans         &trans      &trans      &trans      &trans      &trans         &none
                                   &trans      &trans      &trans         &trans      &trans      &trans
            >;
        };

        adj_layer {
            bindings = <
    &none  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR &trans      &trans      &trans      &trans      &trans         &none
    &none  &to MAC      &to LIN      &trans       &trans       &trans     &trans      &trans      &trans      &trans      &trans         &none
    &none  &trans       &trans       &trans       &trans       &trans     &trans      &trans      &trans      &trans      &trans         &none
                                     &trans       &trans       &trans     &trans      &trans      &trans
            >;
        };
    };
};
